# Copy to .env.docker and fill in real values. .env.docker is git-ignored.
SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/copyright_portal
DB_USERNAME=root
DB_PASSWORD=change-me

# Initial accounts created on first start-up (see DataInitializer).
# Avoid the characters & ^ % ! < > | in passwords used from Windows batch.
APP_ADMIN_EMAIL=admin@copyrightportal.com
APP_ADMIN_PASSWORD=change-me-Admin1
APP_REVIEWER_EMAIL=reviewer@copyrightportal.com
APP_REVIEWER_PASSWORD=change-me-Review1
